# Copy to .env; keep real keys out of Git. This service is a synthetic demo.
HOST=127.0.0.1
PORT=3000
DB_PATH=.local/proof-to-cash.db
# Server-only key. Unset: reminder template fallback; reply/receipt extraction requires manual review.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=10000
# Optional frontend development origin; leave empty for same-origin requests.
FRONTEND_ORIGIN=
