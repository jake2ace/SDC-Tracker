# Load explicitly with: node --env-file=.env src/server.mjs
HOST=127.0.0.1
PORT=3000
DB_PATH=./.local/sdc-tracker.sqlite
# Explicit opt-in: these are selectable synthetic identities, not real login.
DEMO_MODE=true
# Add the frontend developer's exact origin(s), separated by commas.
# Keep empty for same-origin clients and command-line requests only.
CORS_ORIGINS=

# Used by the standalone collections module. Never commit a real key.
DEEPSEEK_API_KEY=
