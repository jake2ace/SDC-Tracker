# The app reads the process environment. On Node 22.13+, load this file with:
# node --env-file=.env src/server.js
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/sdc-tracker.sqlite
# This foundation only has simulated identities; no production login yet.
DEMO_MODE=true
# Set to 1 when serving through HTTPS (for example a Replit preview).
COOKIE_SECURE=0
