{
  "schemaVersion": 1,
  "baseFixture": "demo.json",
  "currency": "MYR",
  "moneyUnit": "sen",
  "conventions": {
    "stateFixtures": "Start from baseFixture for seed. Resolve extends recursively; merge optional settings; apply updates by collection and id, merging set; then append records. These are test arrangements, not API commands.",
    "ownership": "Select company records before calculation. Milestones belong to a company through projectId -> projects.companyId.",
    "dates": "All dates are YYYY-MM-DD in the Asia/Kuala_Lumpur business calendar. Each forecast contains 30 inclusive dates; endDate = baseDate + 29 days.",
    "amounts": "All money values are integer sen. Opening balance is before transactions on baseDate; checkpoints and summary use daily closing balances.",
    "cashAssumptions": "M1 at Studio Lumen was settled before the demo and is included in opening cash. No extra receipt is created for it. Outstanding overdue receipts in an on_time scenario are assumed on baseDate, not asserted to have arrived.",
    "overview": "Amounts cover only the selected company. Planned milestones are excluded from unpaidAmount and pendingIssueAmount. pendingIssueAmount combines pending_approval and approved invoice amounts.",
    "summary": "minDate is the first date at the minimum daily closing balance; firstBreachDate and breachDays use balance < safetyLine.",
    "excludedScope": "No rejected-draft or partial-payment golden cases are introduced here."
  },
